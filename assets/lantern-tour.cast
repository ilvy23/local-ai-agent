[4.705939, "o", "\u001b[93;40m╭─\u001b[0m\u001b[93;40m───────────────────────────\u001b[0m\u001b[93;40m \u001b[0m\u001b[1;93;40m✦ lantern\u001b[0m\u001b[93;40m \u001b[0m\u001b[90;40mv0.1.0\u001b[0m\u001b[93;40m \u001b[0m\u001b[93;40m───────────────────────────\u001b[0m\u001b[93;40m─╮\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[40m                                                                        \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[1;91;40m ◢ CHAT\u001b[0m\u001b[40m                                                                 \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[1;93;40m   [01] \u001b[0m\u001b[37;40mStart a new chat\u001b[0m\u001b[40m                                                \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[1;93;40m   [02] \u001b[0m\u001b[37;40mResume last chat\u001b[0m\u001b[40m                                                \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[1;93;40m   [03] \u001b[0m\u001b[37;40mPast chat sessions\u001b[0m\u001b[40m                                              \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[40m                                                                        \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m│\u001b[0m\u001b[40m \u001b[0m\u001b[90;40m   [ b] back\u001b[0m\u001b[40m                                                            \u001b[0m\u001b[40m \u001b[0m\u001b[93;40m│\u001b[0m\r\n\u001b[93;40m╰─\u001b[0m\u001b[93;40m────────────────────\u001b[0m\u001b[93;40m \u001b[0m\u001b[90;40mselect ▸ number  ·  q to quit\u001b[0m\u001b[93;40m \u001b[0m\u001b[93;40m─────────────────────\u001b[0m\u001b[93;40m─╯\u001b[0m\r\n"]
